# --- network-explorer (canonical protocol API) ----------------------------
VITE_NETWORK_EXPLORER_BASE_URL=https://livepeer-network-api.cloudspe.com/api/v1

# --- performance / leaderboard --------------------------------------------
# Transcoding performance
VITE_PERFORMANCE_TRANSCODING_BASE_URL=https://leaderboard-serverless.vercel.app
# AI pipeline performance
VITE_PERFORMANCE_AI_BASE_URL=https://lpc-leaderboard-serverless.vercel.app

# --- gateway (live Livepeer inference) ------------------------------------
# General-purpose gateway (text-to-image, image-to-image, etc.)
VITE_GATEWAY_BASE_URL=https://dream-gateway.livepeer.cloud
# BYOC OpenAI-compatible gateway
VITE_BYOC_GATEWAY_BASE_URL=https://openai-gateway.livepeer.cloud/v1
# Bearer token; user can override via Settings UI
VITE_GATEWAY_BEARER_TOKEN=
