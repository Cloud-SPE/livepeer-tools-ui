    "@mui/x-data-grid": "^7.23.5",
    "@tanstack/react-query": "^5.62.0",
    "chart.js": "^4.4.7",
    "konva": "^9.3.18",
    "openai": "^6.25.0",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-markdown": "^9.0.1",
